# ESPHome Secrets Configuration Template
# =====================================================
# Copy this file to secrets.yaml and fill in your values
# DO NOT commit secrets.yaml to version control!
# 
# This file contains sensitive information that should be kept private:
# - WiFi credentials
# - API encryption keys
# - OTA password

# WiFi Configuration
wifi_ssid: "YOUR_WIFI_SSID_HERE"
wifi_password: "YOUR_WIFI_PASSWORD_HERE"

# API Encryption Key
# Generate with: esphome/esphome run esphome/rolety-config.yaml
# Copy the generated key here
api_encryption_key: "YOUR_API_ENCRYPTION_KEY_HERE"

# OTA (Over-The-Air) Update Password
ota_password: "YOUR_OTA_PASSWORD_HERE"
